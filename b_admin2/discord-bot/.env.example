# ============================================
# B_ADMIN2 DISCORD BOT - CONFIGURATION
# ============================================

# Discord Bot Token (depuis Discord Developer Portal)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Discord Client ID (Application ID)
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Discord Guild ID (Votre serveur Discord)
GUILD_ID=YOUR_GUILD_ID_HERE

# Channel ID pour les logs staff (optionnel)
STAFF_CHANNEL_ID=YOUR_STAFF_CHANNEL_ID_HERE

# FXServer URL (HTTP endpoint)
FXSERVER_URL=http://localhost:30120

# HMAC Secret (DOIT être identique à Config.DiscordBot.HMACSecret dans config.lua)
HMAC_SECRET=CHANGE_ME_SUPER_SECRET_KEY_MINIMUM_32_CHARS

# Roles Discord autorisés (IDs séparés par virgules)
# Laisser vide pour autoriser tous les membres du serveur
ALLOWED_ROLES=1234567890123456789,9876543210987654321
